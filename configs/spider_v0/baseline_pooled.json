{
  "name": "baseline_pooled",
  "schema": {
    "summary_dim": 16,
    "context_dim": 16,
    "edge_dim": 16,
    "query_dim": 16
  },
  "dataset": {
    "version": "spider-programs-v0.1",
    "manifest_dir": "artifacts/spider_v0/splits"
  },
  "model": {
    "kind": "pooled",
    "d_model": 64,
    "num_heads": 4,
    "num_blocks": 0,
    "tied_recurrence": true,
    "path_rows": 4,
    "evidence_rows": 4,
    "edge_mode": "standard",
    "edge_transforms": 0,
    "adapter_rank": 0,
    "dropout": 0.0
  },
  "controller": {
    "max_rounds": 6,
    "frontier_width": 32,
    "hypotheses_per_node": 1,
    "context_read_budget": 4,
    "max_depth": 8
  },
  "training": {
    "stage": "oracle",
    "steps": 600,
    "batch_size": 16,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "seed": 101,
    "device": "auto",
    "dtype": "auto",
    "log_every": 50,
    "checkpoint_every": 200
  },
  "loss": {
    "priority": 1.0,
    "expand": 1.0,
    "context": 0.5,
    "evidence": 0.75,
    "support_conflict": 0.5,
    "remaining_cost": 0.25,
    "termination": 1.0,
    "consistency": 0.0,
    "search_cost": 0.01,
    "context_cost": 0.01
  }
}
