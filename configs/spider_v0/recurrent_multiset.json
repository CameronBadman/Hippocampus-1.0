{
  "name": "recurrent_multiset",
  "schema": {
    "summary_dim": 16,
    "context_dim": 16,
    "edge_dim": 16,
    "query_dim": 16
  },
  "dataset": {
    "version": "spider-programs-v0.1",
    "manifest_dir": "artifacts/spider_v0/splits"
  },
  "model": {
    "kind": "spider",
    "d_model": 128,
    "num_heads": 4,
    "num_blocks": 2,
    "tied_recurrence": true,
    "path_rows": 8,
    "evidence_rows": 8,
    "edge_mode": "standard",
    "edge_transforms": 0,
    "adapter_rank": 0,
    "dropout": 0.0
  },
  "controller": {
    "max_rounds": 8,
    "frontier_width": 32,
    "hypotheses_per_node": 2,
    "context_read_budget": 4,
    "max_depth": 10
  },
  "training": {
    "stage": "oracle_then_mixed",
    "steps": 800,
    "batch_size": 16,
    "learning_rate": 0.0005,
    "weight_decay": 0.0001,
    "seed": 103,
    "device": "auto",
    "dtype": "auto",
    "oracle_fraction_schedule": [1.0, 0.75, 0.5, 0.25],
    "log_every": 50,
    "checkpoint_every": 200
  },
  "loss": {
    "priority": 1.0,
    "expand": 1.0,
    "context": 0.5,
    "evidence": 0.75,
    "support_conflict": 0.5,
    "remaining_cost": 0.25,
    "termination": 1.0,
    "consistency": 0.1,
    "search_cost": 0.01,
    "context_cost": 0.01
  }
}
